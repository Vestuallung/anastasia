        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "expected_text": {
          "title": "Expected Text",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "reading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading"
        },
        "romaji": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Romaji"
        },
        "display_only": {
          "default": false,
          "title": "Display Only",
          "type": "boolean"
        },
        "author": {
          "default": "agent",
          "title": "Author",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "line_id",
        "expected_text",
        "span",
        "reason"
      ],
      "title": "ReadingOverride",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "overrides": {
      "items": {
        "$ref": "#/$defs/ReadingOverride"
      },
      "title": "Overrides",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "overrides"
  ],
  "title": "OverrideFile",
  "type": "object"
}

